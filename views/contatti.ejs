<%- include('partials/header') %>

    <section
        class="min-h-screen bg-white text-black flex flex-col justify-center items-center px-6 relative overflow-hidden">

        <!-- Background Noise/Texture Effect (Simulated with opacity) -->
        <div class="absolute inset-0 bg-primary opacity-5 pointer-events-none"></div>

        <div class="relative z-10 max-w-5xl mx-auto text-center space-y-12">

            <!-- AGGRESSIVE HEADLINES -->
            <div class="space-y-4">
                <h1
                    class="text-[12vw] sm:text-[8rem] leading-[0.8] font-black tracking-tighter text-primary transform -rotate-2">
                    BASTA SCORRERE.
                </h1>
                <h2
                    class="text-[8vw] sm:text-[4rem] leading-none font-black uppercase tracking-tight text-black opacity-90">
                    SE VUOI IL RISULTATO<br>COMINCIA ORA.
                </h2>
            </div>

            <!-- DIVIDER STAR -->
            <div class="flex justify-center py-8">
                <img src="./assets/Star-5.webp" alt="star" class="w-24 h-24 animate-spin-slow">
            </div>

            <!-- DIRECT MESSAGE -->
            <p
                class="text-xl sm:text-2xl font-bold uppercase tracking-widest max-w-2xl mx-auto border-y-4 border-black py-8">
                Non aspettare che le cose succedano per miracolo. <br>
                Hai un progetto? <span class="bg-primary text-white px-2">Facciamolo.</span>
            </p>

            <!-- CTA BUTTON -->
            <div class="pt-8">
                <a href="mailto:nicola.preda05@gmail.com" class="group relative inline-block">
                    <div
                        class="absolute top-2 left-2 w-full h-full bg-black rounded-none transition-transform duration-300 group-hover:translate-x-2 group-hover:translate-y-2">
                    </div>
                    <div
                        class="relative px-16 py-8 bg-primary border-4 border-black text-white font-black text-3xl sm:text-5xl uppercase tracking-tighter hover:-translate-y-1 hover:-translate-x-1 transition-transform duration-300">
                        CONTATTAMI ORA
                    </div>
                </a>
            </div>

            <!-- FOOTER NOTE -->
            <p class="text-gray-500 font-bold text-sm tracking-widest mt-12 uppercase">
                (Niente perditempo, grazie)
            </p>

        </div>
    </section>

    <%- include('partials/footer') %>