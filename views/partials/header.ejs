    <!-- Preload Critical Assets -->
    <link rel="preload" as="font" href="./assets/SnellRoundhand.ttc" crossorigin>
    <% if (locals.page==='home' ) { %>
        <link rel="preload" as="image" href="./assets/sagoma.svg">
        <% } %>

            <link href="./assets/style.css" rel="stylesheet" />

            <link rel="icon" href="./assets/FAVICON.webp" type="image/webp">

            <style>
                /* Stili per il video Vimeo background */
                .vimeo-background iframe {
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    width: 100vw;
                    height: 56.25vw;
                    /* 16:9 aspect ratio */
                    min-height: 100vh;
                    min-width: 177.77vh;
                    /* 16:9 aspect ratio */
                    transform: translate(-50%, -50%);
                    pointer-events: none;
                }

                @media (max-aspect-ratio: 16/9) {
                    .vimeo-background iframe {
                        height: 100vh;
                        width: 177.77vh;
                    }
                }
            </style>

</head>

<body class="bg-white text-black font-sans overflow-x-hidden">
    <!-- HEADER -->
    <header
        class="absolute top-0 left-0 w-full z-50 px-6 sm:px-16 py-6 flex justify-between items-center bg-transparent">
        <!-- Logo -->
        <a href="./index.html" id="logo-link">
            <img src="./assets/Logo-2.webp" alt="logo" class="h-10 transition-transform ease-out" id="navbar-logo" />
        </a>

        <!-- Desktop menu -->
        <nav class="hidden md:flex gap-6 items-center text-white font-semibold text-lg uppercase tracking-wider">
            <a class="hover:text-gray-200 transition-colors duration-300" href="./index.html">HOME</a>
            <a class="hover:text-gray-200 transition-colors duration-300" href="./portfolio.html">PORTFOLIO</a>
            <a href="./contatti.html"
                class="px-4 py-1 bg-white text-black rounded-sm hover:bg-primary hover:text-white transition-all duration-300">CONTATTI</a>
        </nav>

        <!-- Hamburger Button -->
        <button id="menu-btn" class="block md:hidden text-white z-50 relative w-8 h-8 group focus:outline-none">
            <!-- Icona burger -->
            <svg id="icon-open" xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8 absolute top-0 left-0 transition-all duration-300 ease-in-out transform opacity-100 rotate-0 scale-100"
                fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <!-- Icona X -->
            <svg id="icon-close" xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8 absolute top-0 left-0 transition-all duration-300 ease-in-out transform opacity-0 -rotate-90 scale-50"
                fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>

        <!-- Mobile Menu Overlay -->
        <div id="menu"
            class="fixed inset-0 bg-primary text-white z-40 md:hidden opacity-0 invisible pointer-events-none transition-all duration-500 ease-in-out">
            <div class="h-full flex flex-col justify-center items-center space-y-12 text-center px-8 text-4xl font-bold uppercase translate-y-10 transition-transform duration-500 delay-100"
                id="menu-content">
                <a href="./index.html" class="hover:text-themeYellow transition-colors duration-300">HOME</a>
                <a href="./portfolio.html" class="hover:text-themeYellow transition-colors duration-300">PORTFOLIO</a>
                <a href="./contatti.html" class="hover:text-themeYellow transition-colors duration-300">CONTATTI</a>
            </div>
        </div>
    </header>

    <script>
        // Logo Rotation Animation
        document.addEventListener('DOMContentLoaded', () => {
            const logoLink = document.getElementById('logo-link');
            const logoImg = document.getElementById('navbar-logo');

            // Check if we need to continue rotation from previous page
            if (sessionStorage.getItem('continueLogoRotation')) {
                sessionStorage.removeItem('continueLogoRotation');
                if (logoImg) {
                    // Add class immediately to finish the rotation on this page
                    logoImg.classList.add('duration-[1500ms]', 'rotate-[1080deg]');

                    // Remove after animation completes
                    setTimeout(() => {
                        logoImg.classList.remove('duration-[1500ms]', 'rotate-[1080deg]');
                    }, 1300);
                }
            }

            if (logoLink && logoImg) {
                logoLink.addEventListener('click', (e) => {
                    e.preventDefault(); // Prevent immediate navigation
                    const targetUrl = logoLink.href;

                    // Add rotation classes
                    // Reverting to 2D rotation as requested
                    logoImg.classList.add('duration-[1500ms]', 'rotate-[1080deg]');

                    // Flag for next page to continue
                    sessionStorage.setItem('continueLogoRotation', 'true');

                    // Wait a tiny bit to let the user see the start, then navigate
                    setTimeout(() => {
                        window.location.href = targetUrl;
                    }, 200);
                });
            }
        });
    </script>