    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= (locals.meta && meta.title) ? meta.title : 'Nicola Preda' %>
    </title>
    <meta name="description"
        content="<%= (locals.meta && meta.description) ? meta.description : 'Filmmaker e Fotografo' %>">
    <meta name="keywords"
        content="<%= (locals.meta && meta.keywords) ? meta.keywords : 'Filmmaker, Fotografo, Video, Milano' %>">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= (locals.meta && meta.url) ? meta.url : '' %>">
    <meta property="og:title" content="<%= (locals.meta && meta.title) ? meta.title : 'Nicola Preda' %>">
    <meta property="og:description" content="<%= (locals.meta && meta.description) ? meta.description : '' %>">
    <meta property="og:image" content="<%= (locals.meta && meta.image) ? meta.image : '' %>">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="<%= (locals.meta && meta.url) ? meta.url : '' %>">
    <meta property="twitter:title" content="<%= (locals.meta && meta.title) ? meta.title : 'Nicola Preda' %>">
    <meta property="twitter:description" content="<%= (locals.meta && meta.description) ? meta.description : '' %>">
    <meta property="twitter:image" content="<%= (locals.meta && meta.image) ? meta.image : '' %>">
    <!-- Preconnect & Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap"
