        <div class="flex flex-col sm:flex-row gap-4 items-center justify-center">
            <img src="./assets/Star-4.webp" alt="star4" class="w-24 h-24 animate-spin-slow" />
            <a href="https://www.youtube.com/@nicolapreda" target="_blank"
                class="text-[13vw] sm:text-[100px] md:text-[150px] leading-none transition-colors font-black tracking-tighter mix-blend-screen">YOUTUBE</a>
        </div>
        <a href="https://www.linkedin.com/in/nicola-preda-5b0722233/" target="_blank"
            class="block text-[13vw] sm:text-[100px] md:text-[150px] leading-none transition-colors font-black tracking-tighter mix-blend-screen">LINKEDIN</a>
        <div class="flex flex-col sm:flex-row gap-4 items-center justify-center">
            <img src="./assets/Star-5.webp" alt="star5" class="w-24 h-24 animate-pulse" />
            <a href="mailto:nicola.preda05@gmail.com" target="_blank"
                class="text-[13vw] sm:text-[100px] md:text-[150px] leading-none transition-colors font-black tracking-tighter mix-blend-screen">EMAIL</a>
        </div>
    </section>

    <%- include('partials/footer') %>