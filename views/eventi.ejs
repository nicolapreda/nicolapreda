    <!-- LIGHTBOX MODAL -->
    <div id="gallery-modal"
        class="fixed inset-0 z-[100] bg-black bg-opacity-95 hidden opacity-0 transition-opacity duration-300">


        <!-- Navigation Arrows -->
        <button id="prev-slide"
            class="absolute left-4 md:left-8 top-1/2 -translate-y-1/2 text-white hover:text-gray-400 focus:outline-none z-[70]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 md:h-16 md:w-16" fill="none" viewBox="0 0 24 24"
                stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
            </svg>
        </button>
        <button id="next-slide"
            class="absolute right-4 md:right-8 top-1/2 -translate-y-1/2 text-white hover:text-gray-400 focus:outline-none z-[70]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 md:h-16 md:w-16" fill="none" viewBox="0 0 24 24"
                stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
            </svg>
        </button>

        <!-- Container for Media -->
        <!-- Container for Media (Wrapper for Flex Centering) -->
        <div class="absolute inset-0 flex justify-center items-center pointer-events-none z-[60]">
            <div class="relative max-w-full max-h-full p-4 md:p-12 pointer-events-auto" id="modal-content">
                <!-- Media will be injected here via JS -->
            </div>
        </div>

        <!-- Close Button (Moved here for Z-Index) -->
        <button id="close-modal"
            class="absolute top-6 right-6 text-white bg-black/60 hover:bg-black/90 rounded-full p-2 backdrop-blur-sm transition-all duration-300 focus:outline-none z-[200] shadow-lg border border-white/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 md:h-10 md:w-10" fill="none" viewBox="0 0 24 24"
                stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>

    <script>
        const galleryItems = document.querySelectorAll('.gallery-item');
        const modal = document.getElementById('gallery-modal');
        const modalContent = document.getElementById('modal-content');
        const closeBtn = document.getElementById('close-modal');
        const prevBtn = document.getElementById('prev-slide');
        const nextBtn = document.getElementById('next-slide');

        let currentIndex = 0;

        // Open Modal
        galleryItems.forEach((item, index) => {
            item.addEventListener('click', () => {
                currentIndex = index;
                openModal();
                updateModalContent();
            });
        });

        function openModal() {
            modal.classList.remove('hidden');
            // Small timeout to allow transition to work
            setTimeout(() => {
                modal.classList.remove('opacity-0');
            }, 10);
            document.body.style.overflow = 'hidden'; // Restore scrolling
        }

        function closeModal() {
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
                modalContent.innerHTML = ''; // Clear content to stop video
            }, 300);
            document.body.style.overflow = ''; // Restore scrolling
        }

        // Close events
        closeBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => {
            if (e.target === modal || e.target === modalContent) {
                closeModal();
            }
        });

        // Navigation
        function showNext() {
            currentIndex = (currentIndex + 1) % galleryItems.length;
            updateModalContent();
        }

        function showPrev() {
            currentIndex = (currentIndex - 1 + galleryItems.length) % galleryItems.length;
            updateModalContent();
        }

        nextBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            showNext();
        });
        prevBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            showPrev();
        });

        // Keyboard Navigation
        document.addEventListener('keydown', (e) => {
            if (modal.classList.contains('hidden')) return;

            if (e.key === 'Escape') closeModal();
            if (e.key === 'ArrowRight') showNext();
            if (e.key === 'ArrowLeft') showPrev();
        });

        // Render Media
        function updateModalContent() {
            const currentItem = galleryItems[currentIndex];
            const tagName = currentItem.tagName.toLowerCase();
            const src = currentItem.src; // or currentSource if video

            modalContent.innerHTML = ''; // Clear current

            let newNode;
            if (tagName === 'img') {
                newNode = document.createElement('img');
                newNode.src = src;
                newNode.className = 'max-w-[90vw] max-h-[90vh] object-contain shadow-2xl rounded-sm';
                newNode.style.maxWidth = '90vw';
                newNode.style.maxHeight = '90vh';
            } else if (tagName === 'video') {
                newNode = document.createElement('video');
                newNode.src = src;
                newNode.controls = true;
                newNode.autoplay = true;
                newNode.className = 'max-w-[90vw] max-h-[90vh] object-contain shadow-2xl rounded-sm';
                newNode.style.maxWidth = '90vw';
                newNode.style.maxHeight = '90vh';
                // Try to play
                newNode.onloadeddata = () => {
                    newNode.play().catch(e => console.log("Autoplay prevented", e));
                }
            }

            // Animate in
            newNode.style.opacity = '0';
            newNode.style.transition = 'opacity 0.3s ease';
            modalContent.appendChild(newNode);

            // Trigger reflow/short delay for fade in
            setTimeout(() => {
                newNode.style.opacity = '1';
            }, 50);
        }
    </script>

