<%- include('partials/header') %>

    <!-- HERO SECTION -->
    <section class="relative w-full">
        <div class="pt-[72px]">
            <img src="./assets/sport/galacticos4.jpg" alt="Sport Hero" class="w-full h-auto object-cover mt-[-100px]" />
        </div>
    </section>

    <!-- INTRO: SPORT PHOTOGRAPHY -->
    <section class="px-6 sm:px-16 py-32 lg:py-48 relative flex flex-col items-center">
        <div class="max-w-4xl text-center">
            <h1 class="text-5xl md:text-7xl font-black uppercase mb-8 text-primary tracking-tighter">Sport Photography
            </h1>
            <p
                class="text-xl md:text-2xl leading-relaxed px-4 md:px-16 text-center font-sans font-medium text-gray-700">
                "Catturare l'istante in cui la passione diventa azione. La tensione, la gioia, la fatica: racconto lo
                sport da bordocampo."
            </p>
        </div>
    </section>

    <!-- PROJECT: GALACTICOS (Scrapbook Style) -->
    <section class="relative w-full bg-themeRed text-white py-24 overflow-hidden">

        <!-- DECORATIVE TAPE TOP LEFT -->
        <img src="./assets/Tape.png" class="absolute top-10 left-[-50px] w-48 rotate-45 opacity-80 z-10" />

        <div class="max-w-7xl mx-auto px-6 sm:px-12 relative z-0">

            <!-- HEADER WITH TAPE -->
            <div class="relative mb-20">
                <h2
                    class="text-[12vw] sm:text-[8rem] leading-none font-black text-yellow-400 mix-blend-screen transform -rotate-2 origin-bottom-left">
                    GALACTICOS
                </h2>
                <span
                    class="absolute top-0 right-0 sm:right-20 bg-yellow-400 text-black px-4 py-1 font-bold text-xl uppercase transform rotate-3 shadow-lg">
                    Vele Blu
                </span>
                <p class="mt-4 text-xl sm:text-2xl font-bold tracking-widest uppercase ml-2 sm:ml-4">
                    Passion Project
                </p>
            </div>

            <!-- COLLAGE SECTION 1 -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-32 items-center">

                <!-- Large Image Left -->
                <div class="md:col-span-7 relative group">
                    <img src="./assets/Tape.png"
                        class="absolute -top-6 -left-6 w-24 z-20 rotate-[-15deg] drop-shadow-md opacity-70" />
                    <div class="relative transform transition-transform duration-500 hover:scale-[1.02] hover:rotate-1">
                        <img src="./assets/sport/galacticos4.jpg"
                            class="w-full h-auto shadow-[10px_10px_0px_rgba(0,0,0,0.5)] border-4 border-white transform rotate-1" />
                    </div>
                </div>

                <!-- Text Right -->
                <div class="md:col-span-5 relative">
                    <div class="bg-white text-black p-8 shadow-[10px_10px_0px_rgba(0,0,0,1)] transform -rotate-1">
                        <p class="uppercase font-bold text-2xl mb-6 leading-tight">
                            "L'esperienza con questa squadra è iniziata come progetto personale..."
                        </p>
                        <p class="text-lg leading-relaxed font-medium text-gray-800">
                            In questi due anni ho scattato migliaia di foto ad ogni singola partita.
                            Assieme ad Andrea abbiamo realizzato un profilo Instagram degno di una squadra di Serie A.
                            Tutto questo semplicemente per <span class="bg-themeRed text-white px-1">PASSIONE</span>. 🧡
                        </p>
                    </div>
                </div>
            </div>

            <!-- COLLAGE SECTION 2 (Feed Intro) -->
            <div class="relative mb-16 text-center">
                <h3
                    class="text-4xl sm:text-6xl font-black uppercase text-white transform rotate-1 inline-block border-b-4 border-yellow-400 pb-2">
                    Il Nostro Feed
                </h3>
            </div>

            <!-- INSTAGRAM FEED GRID -->
            <div class="grid grid-cols-3 gap-1 sm:gap-4 p-4 bg-white shadow-2xl transform rotate-1 max-w-5xl mx-auto">
                <!-- Feed Header Mockup -->
                <div class="col-span-3 flex items-center justify-between p-4 border-b border-gray-200 text-black mb-2">
                    <span class="font-bold text-lg">@galacticos_veleblu</span>
                    <button class="bg-blue-500 text-white px-4 py-1 rounded text-sm font-bold">Segui</button>
                </div>

                <!-- Generated Grid from Assets -->
                <div class="aspect-square relative overflow-hidden group cursor-pointer">
                    <img src="./assets/sport/galacticos1.jpg"
                        class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-110" />
                </div>
                <div class="aspect-square relative overflow-hidden group cursor-pointer">
                    <img src="./assets/sport/galacticos2.jpg"
                        class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-110" />
                </div>
                <div class="aspect-square relative overflow-hidden group cursor-pointer">
                    <img src="./assets/sport/galacticos3.jpg"
                        class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-110" />
                </div>
                <div class="aspect-square relative overflow-hidden group cursor-pointer">
                    <img src="./assets/sport/galacticos5.jpg"
                        class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-110" />
                </div>
                <div class="aspect-square relative overflow-hidden group cursor-pointer">
                    <img src="./assets/sport/galacticos4.jpg"
                        class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-110" />
                </div>
                <div class="aspect-square relative overflow-hidden group cursor-pointer">
                    <img src="./assets/sport/galacticos1.jpg"
                        class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-110" />
                </div>
            </div>

        </div>



    </section>

    <!-- PROJECT: ALBINOLEFFE -->
    <section class="px-6 sm:px-16 py-24 bg-gray-50 -mx-6 sm:-mx-16">
        <div class="max-w-7xl mx-auto">
            <div class="border-l-4 border-blue-800 pl-6 mb-12">
                <h2 class="text-4xl font-bold uppercase text-black">Albinoleffe</h2>
                <span class="text-gray-500 font-bold tracking-widest uppercase text-sm">Professional
                    Collaboration</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <div class="group relative overflow-hidden rounded-sm shadow-lg">
                    <img src="./assets/sport/albinoleffe1.JPG"
                        class="w-full h-80 object-cover transition-transform duration-700 group-hover:scale-110" />
                </div>
                <div class="group relative overflow-hidden rounded-sm shadow-lg">
                    <img src="./assets/sport/albinoleffe2.JPG"
                        class="w-full h-80 object-cover transition-transform duration-700 group-hover:scale-110" />
                </div>
                <div class="group relative overflow-hidden rounded-sm shadow-lg">
                    <img src="./assets/sport/albinoleffe3.JPG"
                        class="w-full h-80 object-cover transition-transform duration-700 group-hover:scale-110" />
                </div>
                <div class="group relative overflow-hidden rounded-sm shadow-lg">
                    <img src="./assets/sport/albinoleffe4.JPG"
                        class="w-full h-80 object-cover transition-transform duration-700 group-hover:scale-110" />
                </div>
                <div class="group relative overflow-hidden rounded-sm shadow-lg md:col-span-2">
                    <img src="./assets/sport/albinoleffe5.JPG"
                        class="w-full h-80 object-cover object-top transition-transform duration-700 group-hover:scale-110" />
                </div>
            </div>
        </div>
    </section>

    <%- include('partials/footer') %>